# PostgreSQL (used by the Spring Boot app)
DB_URL=jdbc:postgresql://localhost:5432/api_tracker
DB_USERNAME=api_tracker
DB_PASSWORD=api_tracker

# Temporary API key for admin endpoints (header: X-API-Key)
# Leave empty to allow unauthenticated access in local development only.
API_TRACKER_API_KEY=change-me-in-local-dev
# Set true in shared/staging/prod so a blank server key cannot open the API
REQUIRE_API_KEY=false

# Phase 6 JWT login (dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=change-me-to-a-long-random-secret-key-32b
JWT_EXPIRATION_MS=86400000

# Phase 2 check engine
CHECK_SCHEDULER_ENABLED=true
CHECK_TICK_MS=5000
CHECK_SSRF_PROTECTION_ENABLED=true

# Rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=20
RATE_LIMIT_CHECK_NOW_PER_MIN=30

# Email (monitoring works when MAIL_ENABLED=false)
# MAIL_PROVIDER: mailpit (local SMTP) or brevo (Render/production API)
MAIL_ENABLED=true
MAIL_PROVIDER=mailpit
MAIL_FROM=noreply@apitracker.local
# Keep false on Render when using Brevo (MAIL_PROVIDER=brevo). Only set true for local Mailpit/SMTP.
MAIL_SMTP_HEALTH_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Local inbox when using Mailpit: http://localhost:8025

# Brevo (when MAIL_PROVIDER=brevo on Render)
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=

# Phase 3 Jira (disabled by default; recovery comments only — no auto-close)
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Bug
JIRA_PRIORITY=High

# Optional docker-compose overrides
POSTGRES_DB=api_tracker
POSTGRES_USER=api_tracker
POSTGRES_PASSWORD=api_tracker
POSTGRES_PORT=5432
